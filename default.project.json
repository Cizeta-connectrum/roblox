{
  "name": "CoinSimulator",
  "tree": {
    "$className": "DataModel",
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "CoinManager": {
        "$path": "src/ServerScriptService/CoinManager.server.lua"
      },
      "ShopService": {
        "$path": "src/ServerScriptService/ShopService.server.lua"
      },
      "LeaderboardService": {
        "$path": "src/ServerScriptService/LeaderboardService.server.lua"
      },
      "MapSetup": {
        "$path": "src/ServerScriptService/MapSetup.server.lua"
      }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$className": "Folder",
        "RemoteEvents": {
          "$path": "src/ReplicatedStorage/Modules/RemoteEvents.lua"
        }
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "CoinController": {
          "$path": "src/StarterPlayerScripts/CoinController.client.lua"
        },
        "ShopController": {
          "$path": "src/StarterPlayerScripts/ShopController.client.lua"
        },
        "HudController": {
          "$path": "src/StarterPlayerScripts/HudController.client.lua"
        }
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "ShopGui": {
        "$className": "ScreenGui",
        "$properties": {
          "ResetOnSpawn": false,
          "Enabled": false
        }
      }
    }
  }
}
